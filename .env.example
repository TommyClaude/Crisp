# ── Crisp API ────────────────────────────────────────────────────────────────
# A single production token from YayAssist's approved Crisp Marketplace
# plugin, which reaches every workspace the plugin is installed on — install
# it on each brand's Crisp workspace, then add the brand in /brands. All
# brands share this one token (see README).
# CRISP_WEBSITE_ID is a legacy single-website fallback, only used when no
# brands exist yet.
CRISP_WEBSITE_ID=
CRISP_IDENTIFIER=
CRISP_KEY=

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://crisp:crisp@localhost:5432/crisp_sync

# ── OpenAI (optional — enables vector embeddings for RAG search) ─────────────
# When unset, RAG search falls back to Postgres full-text keyword search.
OPENAI_API_KEY=
# Embedding model used to vectorize chunks (1536 dimensions).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Answer suggester for wp.org forum threads (optional) ─────────────────────
# Provider for drafting forum replies: auto | anthropic | openai.
# "auto" uses Anthropic when ANTHROPIC_API_KEY is set, else OpenAI when
# OPENAI_API_KEY is set. With neither key, /suggestions still shows the
# retrieved context (past chats + docs) without a generated draft.
SUGGESTER_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_CHAT_MODEL=gpt-4o-mini

# Skip forum topics older than this many days at check time (not stored, not
# drafted) — keeps quiet forums' years-old feed items out. Default 30.
# WPORG_TOPIC_MAX_AGE_DAYS=30

# Grace period (days) before a support-team "let me check and get back to you"
# promise is flagged as overdue with the amber "Follow-up due" badge and pulled
# into the "Needs reply" queue on /suggestions. Default 3.
# WPORG_PROMISE_REMINDER_DAYS=3

# ── Admin UI auth (HTTP Basic) ───────────────────────────────────────────────
# Required in production; in development the app runs open with a console
# warning if these are unset.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# ── Sync tuning (optional, sensible defaults) ────────────────────────────────
# Minimum delay between Crisp API requests, in milliseconds.
# CRISP_REQUEST_INTERVAL_MS=150
# Max retries for failed Crisp API requests.
# CRISP_MAX_RETRIES=5
