# Production environment for the self-hosting kit (docker-compose.yml).
#
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# This ONE file is loaded directly (env_file:) into all three containers —
# db, app, and caddy — so there's a single source of truth and no risk of a
# forgotten `--env-file` flag silently blanking a password (see
# docker-compose.yml and docs/DEPLOY.md for why). Never commit this file
# once filled in — .env.production is gitignored, same as .env.
#
# NOTE: env files are NOT shell-interpolated. DATABASE_URL's password below
# must be typed out to literally match POSTGRES_PASSWORD — Compose will not
# substitute ${POSTGRES_PASSWORD} inside another env_file value for you.

# ── Postgres (required — consumed directly by the pgvector/pgvector image) ──
POSTGRES_USER=crisp
# Generate one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=crisp_sync

# ── Database (required) ──────────────────────────────────────────────────────
# Host is "db" — the Postgres service name on the internal compose network,
# not localhost. Keep the password in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://crisp:change-me-to-a-strong-random-value@db:5432/crisp_sync

# ── Domain (required for the VPS path — Caddy profile "vps") ────────────────
# The public hostname pointed (A/AAAA record) at this server. Unused on the
# Mac mini / Cloudflare Tunnel path (docs/DEPLOY.md Option 2), but harmless
# to leave set.
APP_DOMAIN=support.example.com

# ── Timezone (recommended) ───────────────────────────────────────────────────
# Containers default to UTC. Set your team's timezone so server-rendered
# dates, logs, and Postgres timestamps display in local time. The database
# still STORES timestamps in UTC either way — this only affects display.
TZ=Asia/Ho_Chi_Minh

# ── Admin UI auth (HTTP Basic) — required in production ─────────────────────
# The app refuses to serve (503) in production if these are unset. Pick a
# real password — this is the only thing standing between the internet and
# your support data once the tunnel/reverse proxy is up.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-to-a-strong-random-value

# ── Crisp API ────────────────────────────────────────────────────────────────
# A single production token from YayAssist's approved Crisp Marketplace
# plugin, which reaches every workspace the plugin is installed on — install
# it on each brand's Crisp workspace, then add the brand in /brands. All
# brands share this one token (see README).
# CRISP_WEBSITE_ID is a legacy single-website fallback, only used when no
# brands exist yet.
CRISP_WEBSITE_ID=
CRISP_IDENTIFIER=
CRISP_KEY=

# ── OpenAI (optional — enables vector embeddings for RAG search) ─────────────
# When unset, RAG search falls back to Postgres full-text keyword search.
OPENAI_API_KEY=
# Embedding model used to vectorize chunks (1536 dimensions).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Answer suggester for wp.org forum threads (optional) ─────────────────────
# Provider for drafting forum replies: auto | anthropic | openai.
# "auto" uses Anthropic when ANTHROPIC_API_KEY is set, else OpenAI when
# OPENAI_API_KEY is set. With neither key, /suggestions still shows the
# retrieved context (past chats + docs) without a generated draft.
SUGGESTER_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_CHAT_MODEL=gpt-4o-mini

# Base URL for wp.org support-forum feeds ({base}/{slug}/feed/). Only
# overridden in tests — leave unset in production.
# WPORG_FEED_BASE=https://wordpress.org/support/plugin

# Skip forum topics older than this many days at check time (not stored, not
# drafted) — keeps quiet forums' years-old feed items out. Default 30.
# WPORG_TOPIC_MAX_AGE_DAYS=30

# Grace period (days) before a support-team "let me check and get back to you"
# promise is flagged as overdue with the amber "Follow-up due" badge and pulled
# into the "Needs reply" queue on /suggestions. Default 3.
# WPORG_PROMISE_REMINDER_DAYS=3

# Days of customer silence after your team replies last (with no follow-up
# promise) before the topic surfaces in the "Needs resolved" tab on
# /suggestions. Default 3.
# WPORG_SILENCE_NUDGE_DAYS=3

# ── wp.org email push listener (optional — near-realtime forum updates) ──────
# wordpress.org has no webhooks but emails subscribed accounts on every new
# topic/reply. Point a dedicated inbox at those "WordPress.org Forums"
# notifications and the listener (started automatically from
# src/instrumentation.ts when this is enabled) turns each into a targeted
# single-topic check within seconds. The mailbox is opened strictly
# READ-ONLY — never marked seen, moved, or deleted. Disabled unless ENABLED
# is true AND both USER and PASSWORD are set. See README for the wp.org
# Subscribe + Gmail forward + app-password setup.
WPORG_MAIL_ENABLED=false
WPORG_MAIL_HOST=imap.gmail.com
WPORG_MAIL_PORT=993
WPORG_MAIL_USER=
# For Gmail use a 16-character App Password (requires 2FA), NOT the account
# password.
WPORG_MAIL_PASSWORD=

# ── Slack notifications (optional — wp.org topics & replies + drafts) ────────
# Slack Incoming Webhook URL: Slack app → Incoming Webhooks → Add New Webhook
# to Workspace (or create a new app at api.slack.com/apps first). Treat it as
# a secret — anyone with the URL can post to the channel it's bound to. When
# set, that channel gets: new customer topics with their auto-draft (from
# BOTH the feed check and the mail listener), and new CUSTOMER replies on
# already-tracked topics with a suggested whole-thread follow-up draft (mail
# listener only — the feed path re-processes the same reply and would
# double-post). Unset → notifications are silently disabled.
SLACK_WEBHOOK_URL=

# ── Sync tuning (optional, sensible defaults) ────────────────────────────────
# Minimum delay between Crisp API requests, in milliseconds.
# CRISP_REQUEST_INTERVAL_MS=150
# Max retries for failed Crisp API requests.
# CRISP_MAX_RETRIES=5

# NODE_ENV is set by the Dockerfile (production) — do not override here.

# Per-source cap on crawled docs pages ("Crawl URL" and "Sitemap" sources).
# The Knowledge coverage panel warns when a source hits it. Default 300.
# DOCS_CRAWL_MAX_PAGES=300
