# Caddy reverse proxy for the VPS deployment path (docker-compose.yml
# "caddy" service, profile "vps"). Not used on the Mac mini path — see
# docs/DEPLOY.md Option 2, which uses Cloudflare Tunnel instead.
#
# {$APP_DOMAIN} is read from the container's environment (env_file:
# .env.production in docker-compose.yml). Point an A/AAAA record for that
# domain at the VPS before starting this service — Caddy requests and renews
# a Let's Encrypt certificate for it automatically on first request, and
# needs port 80 reachable from the internet for the ACME HTTP-01 challenge
# (both 80 and 443 are published in docker-compose.yml).
{$APP_DOMAIN} {
	# Basic auth is already enforced app-side (src/middleware.ts); Caddy just
	# terminates TLS and proxies everything, including /api/health, straight
	# through unauthenticated at this layer.
	reverse_proxy app:3000

	encode gzip zstd

	log {
		output stdout
		format console
	}
}
