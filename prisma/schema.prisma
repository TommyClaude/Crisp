// Prisma schema for the Crisp conversation archive.
//
// pgvector note: the optional `embedding vector(1536)` column on
// EmbeddingChunk is NOT managed here so that migrations never require the
// pgvector extension. Run `prisma/sql/enable-pgvector.sql` against your
// database to add it (see README). The app detects it at runtime and falls
// back to JSON-stored embeddings / keyword search when absent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A brand = one Crisp website (e.g. YayCommerce, Ninja Team). Sync iterates
// all brands, authenticating with the single global CRISP_IDENTIFIER/CRISP_KEY
// in .env (a Crisp Marketplace plugin production token, installed on every
// brand's workspace); CRISP_WEBSITE_ID in .env is only a legacy single-site
// fallback used when this table is empty.
model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  crispWebsiteId String   @unique
  // wordpress.org author username used to bulk-import the brand's plugins
  // (from wordpress.org/plugins/author/<slug>/) with one click on /brands.
  wpProfileSlug  String?
  // Free-text house-style instructions for this brand's AI reply drafts —
  // sign-off, tone, emoji policy, favorite phrasings. Appended as a clearly
  // delimited section to the drafting system prompts (first-reply and
  // follow-up) so drafts match the team's voice; it is guidance layered on
  // top of, and never overriding, the grounding/correctness rules.
  replyStyle     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plugins       Plugin[]
  conversations Conversation[]
}

// A product/plugin owned by a brand (FileBird, YayMail...). Detection
// keywords drive product tagging of chunks; wpOrgSlug is reserved for the
// future wp.org forum watcher.
model Plugin {
  id                String   @id @default(cuid())
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name              String   @unique
  slug              String   @unique
  wpOrgSlug         String?
  detectionKeywords String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  docsSources    DocsSource[]
  chunks         EmbeddingChunk[]
  supportThreads SupportThread[]

  @@index([brandId])
}

// A topic from a plugin's WordPress.org support forum (via the RSS feed),
// plus the LLM-drafted reply suggestion for human review. Drafts are never
// auto-posted to wp.org.
model SupportThread {
  id           String    @id @default(cuid())
  pluginId     String
  plugin       Plugin    @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  guid         String // feed item guid (topic URL)
  url          String
  title        String
  author       String?
  excerpt      String // topic body text from the feed
  publishedAt  DateTime?
  status       String    @default("new") // new | drafted | failed | reviewed | dismissed
  // Primary draft = the first provider that succeeded (back-compat + watcher).
  draftAnswer  String?
  draftModel   String?
  // One draft per configured LLM provider (Anthropic + OpenAI), so the UI can
  // show both side by side: [{provider, model, text, error}]
  draftsJson   Json?
  // Retrieved chat/docs chunks the draft was grounded on:
  // [{source, similarity, title, link, excerpt, product}]
  contextJson  Json?
  // Follow-up reply drafts, generated only by the manual "Regenerate" action
  // (not the watcher/bulk paths, for cost control). These answer the LATEST
  // customer message in the whole live wp.org thread rather than the opening
  // post: {generatedAt, postCount, drafts:[{provider,model,text,error}],
  // context:[...], skipped?: "no_replies" | "fetch_failed" | "support_last",
  // mode?: "gentle_close" (a permission-to-close reply for a silent thread)}.
  followupJson Json?
  suggestError String?
  // Resurfacing: set when a customer posts a fresh reply on an otherwise old
  // topic (the feed carries reply items too). hasNewReply drives the "New
  // reply" badge and is cleared when the thread is regenerated or its status
  // changes. lastReplyAt is the newest reply date the watcher has processed
  // (used to cheaply dedupe reply items across checks — including support-team
  // replies, which set lastReplyAt without flagging). lastActivityAt is the
  // sort key for the "Recent" tab: publishedAt for fresh topics, bumped to the
  // reply date when a customer resurfaces an old one.
  hasNewReply    Boolean   @default(false)
  lastReplyAt    DateTime?
  lastActivityAt DateTime?
  // Set when the support team's most recent reply promised a further update
  // ("let me check with the team and get back to you") — armed by the watcher's
  // resurface path (a tiny YES/NO LLM classification of that last post) to the
  // reply's date, and cleared when the team delivers/closes, the customer
  // replies, the thread is regenerated, or its status changes. Once it is older
  // than WPORG_PROMISE_REMINDER_DAYS it drives the amber "Follow-up due" badge
  // and pulls the topic into the "Needs reply" work queue.
  followupPromisedAt DateTime?
  // Set when the watcher sees a support-team reply as the newest post WITHOUT a
  // follow-up promise — the ball is with the customer. Cleared when the customer
  // replies (hasNewReply), the thread's status changes (reviewed/dismissed/…),
  // or a promise supersedes it. Drives the "Waiting on customer" state (the
  // topic leaves the "Needs reply" queue), and once it is older than
  // WPORG_SILENCE_NUDGE_DAYS it pulls the topic into the "Needs resolved" tab
  // (topics that can probably be closed) with a "No response" badge.
  waitingSince DateTime?
  // The topic's resolution flag as shown on wordpress.org, refreshed whenever we
  // fetch the live topic page (the watcher's resurface + silent-topic passes and
  // the follow-up Regenerate fetch). false when unknown — we bias toward
  // surfacing, since hiding an unresolved topic defeats the "Needs resolved" tab
  // while showing a resolved one is only minor noise. A topic marked resolved on
  // wp.org is excluded from "Needs resolved" (no point asking to close it).
  wpResolved   Boolean   @default(false)
  fetchedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([pluginId, guid])
  @@index([status])
  @@index([publishedAt])
  @@index([lastActivityAt])
  @@index([followupPromisedAt])
  @@index([waitingSince])
}

// A crawlable documentation source for a plugin (site URL or sitemap.xml).
model DocsSource {
  id            String    @id @default(cuid())
  pluginId      String
  plugin        Plugin    @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  type          String    @default("url") // url (same-path crawl) | sitemap
  url           String
  status        String    @default("idle") // idle | crawling | completed | failed
  lastCrawledAt DateTime?
  pageCount     Int       @default(0)
  chunkCount    Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pages DocsPage[]

  @@index([pluginId])
}

model DocsPage {
  id            String     @id @default(cuid())
  docsSourceId  String
  docsSource    DocsSource @relation(fields: [docsSourceId], references: [id], onDelete: Cascade)
  url           String
  title         String?
  contentText   String
  contentHash   String // sha256 of contentText — unchanged pages keep their chunks
  lastCrawledAt DateTime   @default(now())

  chunks EmbeddingChunk[]

  @@unique([docsSourceId, url])
}

model Conversation {
  id                 String    @id @default(cuid())
  websiteId          String
  brandId            String?
  brand              Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sessionId          String    @unique
  state              String? // pending | unresolved | resolved
  inbox              String?
  createdAtCrisp     DateTime?
  updatedAtCrisp     DateTime?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  visitorEmail       String?
  visitorNickname    String?
  visitorAvatar      String?
  visitorPhone       String?
  visitorUserId      String?
  country            String?
  city               String?
  ip                 String?
  tags               String[]  @default([])
  assignedOperatorId String? // Crisp user_id of the assigned operator
  assignedOperator   Operator? @relation(fields: [assignedOperatorId], references: [crispUserId])
  // Junk detection — keep automated noise (no-reply notification emails, e.g.
  // "[WordPress Plugin] Review pending", never answered by an operator) out of
  // the conversations list AND out of the RAG index the AI learns from. Set
  // transparently by the heuristic classifier (src/lib/crisp/junk.ts) at sync
  // and by the backfill scan, with junkReason recording WHY.
  isJunk       Boolean @default(false)
  // Human-readable reason the classifier (or a manual mark) set this junk —
  // e.g. "automated sender", "bracketed notification subject, never answered",
  // or "marked manually". NULL whenever the conversation is not junk.
  junkReason   String?
  // True once a human manually marked or cleared junk on this row. The
  // auto-classifier (sync + scan) NEVER touches a row with junkOverride set —
  // a human's veto always wins and is never overwritten by a re-scan.
  junkOverride Boolean @default(false)
  rawJson            Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages Message[]
  files    ConversationFile[]
  chunks   EmbeddingChunk[]

  @@index([websiteId])
  @@index([brandId])
  @@index([state])
  @@index([visitorEmail])
  @@index([updatedAtCrisp])
  @@index([lastMessageAt])
  @@index([assignedOperatorId])
  @@index([isJunk])
  @@index([tags], type: Gin)
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Crisp message fingerprint (stringified). When Crisp omits it we store a
  // deterministic surrogate so upserts stay idempotent.
  crispMessageId String?
  sessionId      String
  type           String // text | file | animation | audio | picker | field | carousel | note | event
  from           String // user | operator
  origin         String? // chat | email | urn:*
  userId         String? // Crisp user_id of the sender when from=user
  operatorId     String? // Crisp user_id of the sender when from=operator
  content        String? // plain-text rendering of the message
  contentJson    Json? // structured content for non-text messages
  timestampCrisp DateTime?
  rawJson        Json
  createdAt      DateTime     @default(now())

  files ConversationFile[]

  // Fingerprints are only guaranteed unique within a session, so the upsert
  // key is compound rather than a global unique on crispMessageId.
  @@unique([sessionId, crispMessageId])
  @@index([conversationId])
  @@index([sessionId])
  @@index([timestampCrisp])
  @@index([from])
}

model Operator {
  id          String   @id @default(cuid())
  crispUserId String   @unique
  name        String?
  email       String?
  avatar      String?
  rawJson     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedConversations Conversation[]
}

model ConversationFile {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  sessionId      String
  url            String
  filename       String?
  mimeType       String?
  size           Int?
  rawJson        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([sessionId])
}

model EmbeddingChunk {
  id             String        @id @default(cuid())
  source         String        @default("crisp_chat") // crisp_chat | plugin_docs
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pluginId       String?
  plugin         Plugin?       @relation(fields: [pluginId], references: [id], onDelete: SetNull)
  docsPageId     String?
  docsPage       DocsPage?     @relation(fields: [docsPageId], references: [id], onDelete: Cascade)
  chunkIndex     Int           @default(0)
  messageIds     String[]      @default([])
  chunkText      String
  product        String?
  topic          String?
  language       String?
  // JSON-array fallback storage for the embedding vector; the real
  // `embedding vector(1536)` column is added by prisma/sql/enable-pgvector.sql
  // when pgvector is available.
  embeddingJson  Json?
  rawJson        Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([source])
  @@index([pluginId])
  @@index([docsPageId])
  @@index([product])
  @@index([language])
}

model SyncLog {
  id                  String    @id @default(cuid())
  kind                String    @default("full") // full | incremental | single | range
  status              String // running | completed | failed | cancelled
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  pageFrom            Int?
  pageTo              Int?
  conversationsSynced Int       @default(0)
  messagesSynced      Int       @default(0)
  failedSessions      String[]  @default([])
  error               String?
  // Set only on brand-scoped range runs (see runRangeSync's brandId option);
  // full/incremental runs always cover every brand and leave this null. A
  // plain column with no relation on purpose — SyncLog is history and must
  // survive the brand being deleted later.
  brandId             String?
  // Per-brand page progress for THIS run — {[brandId | "default"]: {from,
  // to, synced}} — updated as the walk advances (same cadence as pageTo),
  // one entry per brand the run has reached so far; `synced` counts that
  // brand's conversations synced this run. The per-brand resume suggestion
  // (see computeResumePages/getResumePages in sync-service.ts) is derived
  // from this across all of history; legacy rows from before this column
  // existed have no entry here and fall back to the old first-brand-only
  // semantics (pageFrom/pageTo counted toward the first configured brand
  // only).
  brandPages          Json?

  @@index([status])
  @@index([startedAt])
  @@index([brandId])
}

// A run of the wp.org forum watcher (the "Check forums now" flow, or cron
// `npm run wporg:check`). Mirrors SyncLog: a durable, per-run history, while
// live progress lives in the check-state globalThis singleton
// (src/lib/wporg/check-state.ts).
model ForumCheckLog {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("running") // running | completed | failed | paused | cancelled
  pluginsChecked Int       @default(0)
  newThreads     Int       @default(0)
  drafted        Int       @default(0)
  skippedOld     Int       @default(0)
  // Old topics resurfaced this run: an existing thread flagged with a fresh
  // customer reply, or a thread created for a customer-last old topic.
  resurfaced     Int       @default(0)
  // Highest 1-based plugin index (alphabetical order) fully processed — the
  // resume point after a graceful Pause/Stop between plugins.
  lastIndex      Int?
  errors         String[]  @default([])

  @@index([status])
  @@index([startedAt])
}

// Small key-value store for app bookkeeping — rebuild timestamps, rule
// versions, and similar single-row flags that don't warrant their own table.
// Powers the "rebuild recommended" staleness notice (see rag/rebuild-advice.ts).
model AppMeta {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
